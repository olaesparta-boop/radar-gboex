# ============================================================
#  Radar GBOEX - variáveis de ambiente
#  Copie este arquivo para ".env" e preencha os valores.
#  Sem nenhuma chave, o radar já roda com as fontes GRÁTIS
#  (Google News, GDELT, site GBOEX). Chaves habilitam o resto.
# ============================================================

# --- Apify (redes sociais: Instagram, TikTok, X, YouTube, Facebook, Reddit) ---
# Crie a conta em https://apify.com e pegue o token em Settings > API tokens
APIFY_TOKEN=

# --- Análise de sentimento por IA (opcional) ---
# Se vazio, usa o analisador léxico PT-BR embutido (offline, sem custo).
# Aceita chave da Anthropic (Claude) para classificação mais precisa.
ANTHROPIC_API_KEY=
# Modelo usado quando a chave acima está preenchida
SENTIMENT_MODEL=claude-haiku-4-5-20251001

# --- Reclame Aqui ---
# A coleta usa a API interna deles por padrão. Se falhar, o Apify assume.
# (nada a preencher aqui além do APIFY_TOKEN acima)
